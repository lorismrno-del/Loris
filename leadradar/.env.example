# ============================================================================
# Lorino Leadradar - Konfiguration
#
# Diese Datei nach ".env" kopieren und anpassen:
#     cp .env.example .env
#
# Ohne .env läuft die App trotzdem - dann mit OpenStreetMap als Datenquelle.
# ============================================================================

# ---- Google Places API (optional, aber deutlich bessere Abdeckung) ---------
# So kommst du an den Key:
#  1. https://console.cloud.google.com  →  Projekt erstellen
#  2. "Places API (New)" aktivieren
#  3. Abrechnung aktivieren (Google gibt monatlich Gratis-Guthaben)
#  4. Anmeldedaten → API-Schlüssel erstellen
#  5. Schlüssel einschränken auf "Places API (New)"
GOOGLE_PLACES_API_KEY=

# Bewertungen mitladen (zeigt "seit X Jahren keine Aktivität").
# Kostet mehr pro Anfrage - auf false setzen, wenn du sparen willst.
GOOGLE_INCLUDE_REVIEWS=true

# Wie viele Ergebnisseiten pro Suchbegriff (1 Seite = 20 Betriebe, max. 3)
GOOGLE_MAX_PAGES=3

# ---- Deine Stammdaten -----------------------------------------------------
# Können auch direkt in der App unter "Einstellungen" geändert werden.
AGENCY_NAME=Lorino Co.
AGENCY_OWNER=Loris Marino
AGENCY_PHONE=+41 76 520 10 46
AGENCY_EMAIL=info@lorinoweb.ch
AGENCY_WEBSITE=https://lorino-co.ch
AGENCY_INSTAGRAM=@lorino_co

# ---- Server ---------------------------------------------------------------
PORT=3000
HOST=127.0.0.1

# ---- Website-Prüfung ------------------------------------------------------
# Wie lange auf eine Webseite gewartet wird (Millisekunden)
AUDIT_TIMEOUT_MS=12000
# Wie viele Webseiten gleichzeitig geprüft werden.
# Höher = schneller, aber belastet deine Leitung stärker.
AUDIT_CONCURRENCY=6

# ---- Standard-Suchgebiet --------------------------------------------------
DEFAULT_REGION=Zürich
DEFAULT_RADIUS_KM=15
